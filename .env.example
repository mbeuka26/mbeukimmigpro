# Supabase (frontend — clé publishable / anon uniquement)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# --- Hub Central (serveur Edge Functions uniquement) ---
MBEUK_ENVIRONMENT=development
MBEUK_HUB_URL=https://mbeukhub.vercel.app
MBEUK_HUB_API_KEY=mbs_REPLACE_WITH_SERVER_SECRET
MBEUK_PRODUCT_ID=00000000-0000-0000-0000-000000000000
MBEUK_APPLICATION_ID=00000000-0000-0000-0000-000000000000
MBEUK_AUTH_BRIDGE_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM
ADMIN_SECRET=REPLACE_WITH_ADMIN_DIAGNOSTIC_SECRET

# Edge Functions / CI uniquement — jamais dans le frontend
SUPABASE_SERVICE_ROLE_KEY=
BYOK_MASTER_KEY_BASE64=
CENTRAL_OPENAI_API_KEY=
CENTRAL_ANTHROPIC_API_KEY=
CENTRAL_GOOGLE_API_KEY=
CENTRAL_XAI_API_KEY=
CENTRAL_OPENROUTER_API_KEY=
CENTRAL_MISTRAL_API_KEY=
CRAWLER_CRON_SECRET=
