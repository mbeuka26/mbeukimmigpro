# =============================================================================
# NATIVA SaaS Integration Kit — variables d'environnement (EXEMPLE SANS SECRETS)
# =============================================================================
# Copier vers .env (local) ou secrets hébergeur (Supabase / Vercel / CI).
# Ne jamais committer de valeurs réelles.
# =============================================================================

# --- Environnement ---
MBEUK_ENVIRONMENT=development
# development | staging | production

# --- Hub Central (serveur uniquement) ---
MBEUK_HUB_URL=https://your-hub.example.com
MBEUK_HUB_API_KEY=mbs_REPLACE_WITH_SERVER_SECRET
MBEUK_PRODUCT_ID=00000000-0000-0000-0000-000000000000
MBEUK_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# --- Pont auth SaaS ↔ Hub (Edge Functions) ---
MBEUK_AUTH_BRIDGE_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM
MBEUK_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE

# --- Frontend public (Supabase technique du SaaS — PAS la clé Hub) ---
VITE_SUPABASE_URL=https://your-saas-project.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# --- Optionnel : liens marketing (auth page) ---
WEBSITE_LINK=https://www.example.com
WHATSAPP_LINK=https://wa.me/0000000000
FACEBOOK_LINK=https://www.facebook.com/example

# --- Diagnostics admin (Edge Function hub-diagnostics) ---
ADMIN_SECRET=REPLACE_WITH_ADMIN_DIAGNOSTIC_SECRET

# =============================================================================
# INTERDIT côté frontend / VITE_* / bundle navigateur :
#   MBEUK_HUB_API_KEY, MBEUK_AUTH_BRIDGE_SECRET, MBEUK_SERVICE_ROLE_KEY,
#   secrets paiement Chariow, webhooks secrets
# =============================================================================
